# Windows Jarvis AI Assistant 환경 설정 예시
# 이 파일을 .env로 복사한 뒤 필요한 값만 채우세요.
# OpenAI/Anthropic API 키는 선택 사항입니다. 비워 두어도 Jarvis는 로컬 모드로 동작합니다.
# 실제 API 키는 Git에 커밋하지 마세요.

# ------------------------------------------------------------
# 선택 기능: ChatGPT / OpenAI 설정
# ------------------------------------------------------------
# 지금은 비워 두세요. 나중에 OpenAI API를 연결할 때 등호 뒤에 키를 입력합니다.
OPENAI_API_KEY=

# ChatGPT Provider에서 사용할 모델명입니다.
JARVIS_OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# 선택 기능: Claude / Anthropic 설정
# ------------------------------------------------------------
# 지금은 비워 두세요. 나중에 Anthropic API를 연결할 때 등호 뒤에 키를 입력합니다.
ANTHROPIC_API_KEY=

# Claude Provider에서 사용할 모델명입니다.
JARVIS_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ------------------------------------------------------------
# Jarvis Provider 라우팅 설정
# ------------------------------------------------------------
# API 없이 동작하는 기본 Provider입니다.
# 사용 가능 값: local, windows_automation, open_interpreter, chatgpt, claude
JARVIS_DEFAULT_PROVIDER=local

# 자동 라우팅 fallback 우선순위입니다.
# API 없이도 local/windows_automation/open_interpreter가 먼저 동작하고,
# 나중에 API 키를 넣으면 chatgpt/claude도 같은 구조에서 사용할 수 있습니다.
JARVIS_PROVIDER_PRIORITY=windows_automation,open_interpreter,local,chatgpt,claude

# Jarvis 워크스페이스 루트입니다.
# Windows 예: C:\Users\you\Jarvis
# 비워두면 Jarvis가 현재 위치에서 자동 탐색합니다.
JARVIS_WORKSPACE_ROOT=

# SQLite 장기 기억 DB 경로입니다.
# 비워두면 Jarvis가 JARVIS_WORKSPACE_ROOT/Memory/jarvis_memory.sqlite3를 사용합니다.
JARVIS_MEMORY_DB_PATH=

# ------------------------------------------------------------
# Open Interpreter CLI 설정
# ------------------------------------------------------------
# Windows 예: .\.venv\Scripts\interpreter.exe
# Linux/Cloud Agent 예: .venv/bin/interpreter
JARVIS_OPEN_INTERPRETER_COMMAND=interpreter

# Open Interpreter가 사용할 안전 작업 폴더입니다.
# 반드시 JARVIS_WORKSPACE_ROOT 내부 경로여야 합니다.
# 비워두면 Jarvis가 Temp/OpenInterpreter를 사용합니다.
JARVIS_OPEN_INTERPRETER_WORKDIR=

# Open Interpreter 실행 제한 시간(초)입니다.
JARVIS_OPEN_INTERPRETER_TIMEOUT_SECONDS=120

# true로 설정하면 Open Interpreter가 생성한 코드를 자동 실행할 수 있습니다.
# 안전을 위해 기본값은 false입니다.
JARVIS_OPEN_INTERPRETER_AUTO_YES=false

# true이면 로컬 파일/명령 실행 요청에 --confirm-local-execution 확인이 필요합니다.
JARVIS_OPEN_INTERPRETER_REQUIRE_CONFIRMATION=true
