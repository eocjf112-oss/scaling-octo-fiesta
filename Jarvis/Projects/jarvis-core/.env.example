# ============================================================
# Jarvis AI Assistant — 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요!
# ============================================================

# ─────────────────────────────────────────────
# AI 프로바이더 API 키
# ─────────────────────────────────────────────

# OpenAI (ChatGPT)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# Open Interpreter 설정
# ─────────────────────────────────────────────
INTERPRETER_SAFE_MODE=false
INTERPRETER_AUTO_RUN=false
INTERPRETER_MODEL=gpt-4o
INTERPRETER_OFFLINE=false

# ─────────────────────────────────────────────
# Jarvis 시스템 설정
# ─────────────────────────────────────────────
JARVIS_LANGUAGE=ko
JARVIS_DEFAULT_PROVIDER=claude
JARVIS_MEMORY_PATH=../../Memory
JARVIS_LOG_PATH=../../Logs
JARVIS_LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# 사용자 설정
# ─────────────────────────────────────────────
USER_NAME=사용자
USER_TIMEZONE=Asia/Seoul

# ─────────────────────────────────────────────
# 고급 설정 (선택)
# ─────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=20
SESSION_TIMEOUT_MINUTES=60
ENABLE_VOICE=false
ENABLE_AUTO_MEMORY=true
DEBUG_MODE=false
