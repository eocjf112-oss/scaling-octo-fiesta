# ════════════════════════════════════════════════
#  Jarvis AI Assistant — 환경변수 설정 파일
#  이 파일을 복사하여 .env 로 저장한 뒤 값을 입력하세요
#  cp .env.example .env
# ════════════════════════════════════════════════

# ── OpenAI (ChatGPT) ─────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ── Anthropic (Claude) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=8192

# ── Open Interpreter ─────────────────────────
# INTERPRETER_MODEL=gpt-4o
# INTERPRETER_API_KEY=  # 비워두면 OPENAI_API_KEY 사용

# ── Jarvis 시스템 설정 ───────────────────────
JARVIS_DEFAULT_AI=auto        # auto | chatgpt | claude | interpreter
JARVIS_LANGUAGE=ko            # 응답 언어: ko (한국어), en (영어)
JARVIS_WORKSPACE=C:\Jarvis    # Windows 워크스페이스 경로
JARVIS_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR

# ── 메모리 설정 ─────────────────────────────
JARVIS_MEMORY_AUTO_SAVE=true  # 세션 종료 시 자동 저장
JARVIS_MEMORY_MAX_SESSIONS=50 # 최대 세션 기록 수
